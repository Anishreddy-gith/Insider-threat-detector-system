###############################################################################
#  ITDS – Insider Threat Detection System
#  Environment Variable Template
#
#  Copy this file to `.env` and fill in production values.
#  Variables with defaults are safe for local development.
###############################################################################

# ── General ──────────────────────────────────────────────────────────
DEBUG=false                              # Enable debug endpoints (/docs)
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# ── PostgreSQL 16 ────────────────────────────────────────────────────
POSTGRES_USER=itds                       # Database superuser
POSTGRES_PASSWORD=itds_secret            # ** CHANGE IN PRODUCTION **
POSTGRES_DB=itds                         # Default database name
POSTGRES_HOST=postgres                   # Docker service name
POSTGRES_PORT=5432                       # Default PG port

# ── Redis 7 ──────────────────────────────────────────────────────────
REDIS_PASSWORD=itds_redis                # ** CHANGE IN PRODUCTION **
REDIS_URL=redis://:itds_redis@redis:6379/0

# ── Kafka 3.7 ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092       # Comma-separated broker list
KAFKA_AUTO_CREATE_TOPICS=true            # Let brokers create topics

# ── API Gateway (port 8000) ──────────────────────────────────────────
JWT_SECRET=change_me_in_production       # HMAC-SHA256 signing key (≥ 32 chars)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30                # Access token TTL
RATE_LIMIT_PER_MINUTE=200                # Per-IP rate limit

# ── Ingestion Service (port 8001) ────────────────────────────────────
INGESTION_RATE_LIMIT=5000                # Events per second
INGESTION_MAX_BATCH_SIZE=1000            # Max events in a batch POST
KAFKA_RAW_EVENTS_TOPIC=itds.raw-events

# ── ML Engine (port 8002) ────────────────────────────────────────────
MODEL_DIR=/app/models/weights            # Mount path for trained weights
AUTOENCODER_HIDDEN_DIM=128
GNN_HIDDEN_DIM=64
GNN_NUM_LAYERS=3
ENSEMBLE_WEIGHTS=0.6,0.4                # autoencoder,gnn weighting
SHAP_THRESHOLD=0.65                      # Anomaly score above which to compute XAI
DP_EPSILON=1.0                           # Differential privacy budget
DP_DELTA=1e-5

# ── Risk Scoring Service (port 8003) ─────────────────────────────────
RISK_DECAY_LAMBDA=0.01                   # Exponential decay rate (per hour)
KAFKA_ANOMALIES_TOPIC=itds.anomalies
KAFKA_RISK_SCORES_TOPIC=itds.risk-scores

# ── Alert Service (port 8004) ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://itds:itds_secret@postgres:5432/itds_alerts
KAFKA_ALERTS_TOPIC=itds.alerts
THRESHOLD_CRITICAL=75.0
THRESHOLD_HIGH=50.0
THRESHOLD_MEDIUM=25.0

# Notification Channels (optional)
SMTP_HOST=                               # e.g. smtp.gmail.com
SMTP_PORT=587
SLACK_WEBHOOK_URL=                       # Incoming Webhook URL
PAGERDUTY_ROUTING_KEY=                   # Events API v2 routing key

# ── Frontend (port 3000) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8000       # API Gateway URL exposed to browser

# ── Cryptography ─────────────────────────────────────────────────────
ENCRYPTION_KEY=                          # 32-byte hex key for AES-256-GCM
PSEUDONYMISATION_SECRET=                 # HMAC secret for PII hashing

# ── Monitoring ───────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Feature Flags ────────────────────────────────────────────────────
ENABLE_FEDERATED_LEARNING=false
ENABLE_GNN_MODEL=true
ENABLE_EXPLAINABILITY=true
DATA_RETENTION_DAYS=90
